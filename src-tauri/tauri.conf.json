{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spool Ledger",
  "version": "0.9.0",
  "identifier": "io.github.remindz.bambu-filament-migrator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spool Ledger · Bambu Filament Migrator",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Utility",
    "copyright": "Copyright (C) 2026 Matthias (RemindZ)",
    "licenseFile": "../LICENSE",
    "shortDescription": "Migrate filament presets into Bambu custom filaments",
    "longDescription": "Migrate OrcaSlicer and Bambu Studio filament presets into Bambu custom filaments for AMS-compatible printers."
  }
}
